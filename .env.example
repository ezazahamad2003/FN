SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret
SHOPIFY_SCOPES=read_products,write_products,read_files,write_files,read_publications,write_publications
SHOPIFY_REDIRECT=http://localhost:3456/callback

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT=http://localhost:3456/google/callback
# Parent Drive folder for all department folders.
# Current production folder: 1NotimWFnxitY67QLt20is3IwifNXfgnp
GDRIVE_PARENT_FOLDER_ID=your-drive-parent-folder-id

# Primary Google account refresh token (set this in Render env for persistence).
GOOGLE_REFRESH_TOKEN=

# Optional second Google account for automatic failover. Both accounts must have
# access to GDRIVE_PARENT_FOLDER_ID — folder ids and links stay identical no
# matter which account writes. Client id/secret default to the primary app
# above; only set the *_2 client vars if the second account used a different
# OAuth app.
GOOGLE_REFRESH_TOKEN_2=
GOOGLE_CLIENT_ID_2=
GOOGLE_CLIENT_SECRET_2=

# Legacy OpenAI fallback for local development. Azure OpenAI is preferred for Azure deploys.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
# Optional: image model for blank garment bases (default gpt-image-1).
OPENAI_IMAGE_MODEL=

# Azure OpenAI Service.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
# Speech-to-text deployment. AZURE_OPENAI_VOICE_DEPLOYMENT is kept as a legacy alias.
# Set AUDIO_* only when Whisper lives in a separate Azure OpenAI resource.
AZURE_OPENAI_AUDIO_ENDPOINT=
AZURE_OPENAI_AUDIO_API_KEY=
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=
AZURE_OPENAI_VOICE_DEPLOYMENT=
AZURE_OPENAI_AUDIO_API_VERSION=2024-10-21
# Optional text-to-speech model/deployment for spoken replies. Browser speech is used when unset.
AZURE_OPENAI_SPEECH_MODEL=
AZURE_OPENAI_SPEECH_API_VERSION=preview
AZURE_OPENAI_SPEECH_VOICE=alloy

# Azure platform services.
DATABASE_URL=
POSTGRES_CONNECTION_STRING=
AZURE_KEY_VAULT_NAME=
AZURE_STORAGE_CONNECTION_STRING=


# Price applied to every published variant (default 24.00).
DEFAULT_PRODUCT_PRICE=24.00
# Vendor set on every published product (e.g. "One Week Item").
DEFAULT_PRODUCT_VENDOR=
PORT=3456

# Internal dashboard token for the New Stores review queue.
FN_ADMIN_TOKEN=
